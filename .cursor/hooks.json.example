{
  "version": 1,
  "hooks": {
    "afterAgentResponse": [
      {
        "command": "cmd /c \"REPO_ROOT\\run_hook.cmd\"",
        "timeout": 30
      }
    ],
    "stop": [
      {
        "command": "cmd /c \"REPO_ROOT\\run_hook.cmd\"",
        "timeout": 30,
        "loop_limit": 0
      }
    ]
  }
}
